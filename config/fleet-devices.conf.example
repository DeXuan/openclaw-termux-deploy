# ── SSH 连接信息 ──
DEV_SSH_K60="u0_a129@100.118.60.29:8022"
DEV_SSH_NOTE7="u0_a171@100.91.94.44:8022"
DEV_SSH_MIX2S="u0_a129@100.104.72.125:8022"
DEV_SSH_NOTE4X="u0_a129@192.168.1.19:8022"

# ── 设备元数据 ──
DEV_LABEL_K60="随身主力机"
DEV_LABEL_NOTE7="家里轻量机"
DEV_LABEL_MIX2S="稳定副机"
DEV_LABEL_NOTE4X="韧性备机"

DEV_ROLE_K60="OC+HM双引擎"
DEV_ROLE_NOTE7="OC+HM双引擎"
DEV_ROLE_MIX2S="OC+HM双引擎"
DEV_ROLE_NOTE4X="OpenClaw"

DEV_HERMES_K60="v0.19.0"
DEV_HERMES_NOTE7="v0.19.0"
DEV_HERMES_MIX2S="v0.19.0"
DEV_HERMES_NOTE4X="—"

# ── 自愈监控配对 (TARGET SLEEP SSH_FAIL_ALERT) ──
HEALTHCHECK_TARGET_K60="u0_a171@100.91.94.44:8022 20 1"
HEALTHCHECK_TARGET_NOTE7="u0_a129@100.118.60.29:8022 20 1"
HEALTHCHECK_TARGET_MIX2S="u0_a129@100.118.60.29:8022 25 1"
