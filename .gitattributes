# Auto-detect text files, normalize line endings
* text=auto

# Shell scripts must use LF
*.sh text eol=lf

# Python
*.py text eol=lf diff=python

# Documentation
*.md text eol=lf diff=markdown

# CI / Config
*.yml text eol=lf
*.yaml text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Binary
*.png binary
*.jpg binary
*.gif binary
*.apk binary
*.deb binary
*.gz binary
