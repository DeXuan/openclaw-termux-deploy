#!/usr/bin/env bash
#==============================================================================
# OpenClaw + Hermes Deploy — Termux Fleet Management Toolbox
# 用法: ./openclaw-deploy              交互式 TUI
#       ./openclaw-deploy dashboard    机队仪表盘
#       ./openclaw-deploy wizard       新手向导
#       ./openclaw-deploy check        全队体检
#       ./openclaw-deploy fleet-scan   全队深度体检(9维+HTML报告)
#       ./openclaw-deploy hermes        Hermes 服务管理
#==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh"
source "$SCRIPT_DIR/lib/menus.sh"
VERSION="2.0.0"

# ═══ Guard ═══
require_openclaw() {
  if ! command -v openclaw &>/dev/null; then
    echo
    log_fail "未检测到 openclaw 命令"
    echo -e "  ${C_DIM}请先完成部署（主菜单选「新手向导」或「部署设备」）${C_RESET}"
    echo -e "  ${C_DIM}或确认 PATH 包含 ~/.npm-global/bin${C_RESET}"
    return 1
  fi
  return 0
}

# ═══ CLI Mode ═══
if [ $# -gt 0 ]; then
  case "$1" in
    wizard|w) wizard_menu; exit 0 ;;
    dashboard|dash|d)
      shift
      if [ "${1:-}" = "--json" ] || [ "${1:-}" = "-j" ]; then
        printf '{"devices":{'
        first=true
        for dev in K60 Note7 MIX2S Note4X; do
          gw=$(ssh_device "$dev" 'curl -s -o /dev/null -w "%{http_code}" --connect-timeout 3 http://127.0.0.1:18789/' 2>/dev/null) || gw="fail"
          mem=$(ssh_device "$dev" "free -m 2>/dev/null | awk '/Mem:/{printf \"%.1f/%.1f\",\$7/1024,\$2/1024}'" 2>/dev/null) || mem="N/A"
          disk=$(ssh_device "$dev" "df -h /data 2>/dev/null | awk 'NR==2{print \$5}'" 2>/dev/null) || disk="N/A"
          up=$(ssh_device "$dev" "uptime -p 2>/dev/null | sed 's/up //'" 2>/dev/null) || up="N/A"
          $first || printf ','
          printf '"%s":{"gw":"%s","mem":"%s","disk":"%s","up":"%s"}' "$dev" "$gw" "$mem" "$disk" "$up"
          first=false
        done
        echo '}}'
      else
        dashboard_menu
      fi
      exit 0
      ;;
    logs|l)
      target="${2:-K60}"; lines="${3:-50}"
      logpath='$PREFIX/var/log/sv/openclaw/current'
      if [ "$target" = "--all" ] || [ "$target" = "-a" ]; then
        for dev in K60 Note7 MIX2S Note4X; do
          echo -e "\n${C_BOLD}─── $dev: tail -$lines ───${C_RESET}"
          ssh_device "$dev" "tail -$lines $logpath 2>/dev/null" || echo "  不可达"
        done
      else
        echo -e "${C_BOLD}─── $target: tail -$lines ───${C_RESET}"
        ssh_device "$target" "tail -$lines $logpath 2>/dev/null" || echo "  不可达"
      fi
      exit 0
      ;;
    service|sv|s)
      action="${2:-status}"; target="${3:-K60}"
      # --all 批量操作所有设备
      if [ "$target" = "--all" ] || [ "$target" = "-a" ]; then
        for dev in K60 Note7 MIX2S Note4X; do
          echo -e "\n${C_BOLD}─── $dev ───${C_RESET}"
          case "$action" in
            status) ssh_device "$dev" "export SVDIR=\$PREFIX/var/service && sv status openclaw 2>&1" || echo "  不可达" ;;
            restart|up|down)
              echo -e "  ${C_YELLOW}${action}...${C_RESET}"
              ssh_device "$dev" "export SVDIR=\$PREFIX/var/service && sv $action openclaw 2>&1" || echo "  不可达"
              ;;
          esac
        done
      else
        case "$action" in
          status) ssh_device "$target" "export SVDIR=\$PREFIX/var/service && sv status openclaw 2>&1" || echo "  不可达" ;;
          restart|up|down)
            echo -e "${C_YELLOW}${action} openclaw on $target...${C_RESET}"
            ssh_device "$target" "export SVDIR=\$PREFIX/var/service && sv $action openclaw 2>&1" || echo "  不可达"
            ;;
          *) echo "用法: $0 service [status|restart|up|down] [device|--all]" ;;
        esac
      fi
      exit 0
      ;;
    check|c)
      ck="$SCRIPT_DIR/scripts/phone_check_env.sh"
      [ ! -f "$ck" ] && ck="$SCRIPT_DIR/skill/scripts/phone_check_env.sh"
      targets=("${@:2}")
      # --all 或空参数 → 默认全队
      if [ ${#targets[@]} -eq 0 ] || [ "${targets[0]}" = "--all" ] || [ "${targets[0]}" = "-a" ]; then
        targets=(K60 Note7 MIX2S Note4X)
      fi
      for dev in "${targets[@]}"; do
        echo -e "\n${C_BOLD}─── $dev ───${C_RESET}"
        ssh_device "$dev" "sh -" < "$ck" 2>&1 || echo "  不可达"
      done
      exit 0
      ;;
    install|i)
      target="${2:-}"; [ -z "$target" ] && { echo "用法: $0 install <K60|Note7|MIX2S|Note4X|IP> [user]"; exit 1; }
      # Resolve device name to IP if in fleet
      if [ -n "${DEVICES[$target]:-}" ]; then
        conn="${DEVICES[$target]}"
        target="${conn%:*}"
      fi
      user="${3:-u0_a129}"
      inst="$SCRIPT_DIR/scripts/phone_install_openclaw.sh"
      [ ! -f "$inst" ] && inst="$SCRIPT_DIR/skill/scripts/phone_install_openclaw.sh"
      echo -e "${C_YELLOW}Installing on $target as $user...${C_RESET}"
      cat "$inst" | ssh -p 8022 "$user@$target" 'sh -'
      exit 0
      ;;
    fleet-scan|fs)
      # --html 标志: 生成 HTML 报告到桌面
      if [ "${2:-}" = "--html" ] || [ "${2:-}" = "-H" ]; then
        local reporter="$SCRIPT_DIR/scripts/generate_fleet_report.sh"
        if [ -f "$reporter" ]; then
          bash "$reporter" "${3:-}"
        else
          echo "错误: 找不到 generate_fleet_report.sh"
          exit 1
        fi
        exit 0
      fi
      fs="$SCRIPT_DIR/scripts/fleet_scan.sh"
      [ ! -f "$fs" ] && fs="$SCRIPT_DIR/skill/scripts/fleet_scan.sh"
      targets=("${@:2}")
      if [ ${#targets[@]} -eq 0 ] || [ "${targets[0]}" = "--all" ] || [ "${targets[0]}" = "-a" ]; then
        targets=(K60 Note7 MIX2S Note4X)
      fi
      for dev in "${targets[@]}"; do
        echo -e "\n${C_BOLD}═══ $dev ═══${C_RESET}"
        cat "$fs" | ssh_device "$dev" 'bash -' 2>&1 || echo "  不可达"
      done
      echo -e "\n${C_DIM}提示: 加 --html 自动生成 HTML 报告到桌面${C_RESET}"
      exit 0
      ;;
    hermes|hm)
      action="${2:-status}"; target="${3:-}"
      case "$action" in
        status|s)
          if [ -z "$target" ] || [ "$target" = "--all" ] || [ "$target" = "-a" ]; then
            for dev in K60 Note7 MIX2S; do
              echo -e "\n${C_BOLD}─── $dev Hermes ───${C_RESET}"
              ssh_device "$dev" "export SVDIR=\$PREFIX/var/service && sv status hermes-gateway 2>&1" || echo "  不可达"
            done
          else
            ssh_device "$target" "export SVDIR=\$PREFIX/var/service && sv status hermes-gateway 2>&1" || echo "  不可达"
          fi
          ;;
        restart|up|down)
          if [ -z "$target" ]; then
            echo "用法: $0 hermes $action <K60|Note7|MIX2S|--all>"
            exit 1
          fi
          if [ "$target" = "--all" ] || [ "$target" = "-a" ]; then
            for dev in K60 Note7 MIX2S; do
              echo -e "${C_YELLOW}${action} hermes on $dev...${C_RESET}"
              ssh_device "$dev" "export SVDIR=\$PREFIX/var/service && sv $action hermes-gateway 2>&1" || echo "  不可达"
            done
          else
            echo -e "${C_YELLOW}${action} hermes on $target...${C_RESET}"
            ssh_device "$target" "export SVDIR=\$PREFIX/var/service && sv $action hermes-gateway 2>&1" || echo "  不可达"
          fi
          ;;
        e2e|test)
          target="${target:-K60}"
          echo -e "${C_YELLOW}Hermes E2E test on $target...${C_RESET}"
          ssh_device "$target" 'cd ~/.hermes && source .env && timeout 20 hermes chat -q "只回复OK" --yolo --max-turns 1 2>&1' || echo "  失败"
          ;;
        *)
          echo "用法: $0 hermes [status|restart|e2e] [K60|Note7|MIX2S|--all]"
          exit 1
          ;;
      esac
      exit 0
      ;;
    version|--version|-v)
      echo "openclaw-deploy v$VERSION"
      exit 0
      ;;
    help|--help|-h)
      echo "openclaw-deploy v$VERSION — OpenClaw + Hermes Termux 机队管理工具箱"
      echo ""
      echo "命令:"
      echo "  dashboard, d         机队仪表盘 (OC+HM 双引擎)"
      echo "  dashboard --json    机队状态 (JSON 输出)"
      echo "  wizard, w           新手部署向导"
      echo "  check [dev...]       全队体检 (默认四台)"
      echo "  fleet-scan, fs [dev] 全队深度体检 (9维+并行+HTML报告)"
      echo "  logs <dev> [n]       查看远程日志 (--all 全队)"
echo "  service <action> <d>  OpenClaw 服务管理 (--all 全队)"
echo "  hermes, hm <action>   Hermes 管理 (status/restart/e2e)"
      echo "  install <dev> [usr] 远程部署"
      echo "  version             版本号"
      echo "  help                帮助信息"
      echo ""
      echo "设备名: K60 | Note7 | MIX2S | Note4X"
      echo ""
      echo "示例:"
      echo "  ./openclaw-deploy fleet-scan --all"
      echo "  ./openclaw-deploy hermes status --all"
      echo "  ./openclaw-deploy hermes e2e K60"
      echo "  ./openclaw-deploy hermes restart MIX2S"
      echo "  ./openclaw-deploy service restart --all"
      echo "  ./openclaw-deploy check --all"
      exit 0
      ;;
    *) echo "未知命令: $1"; echo "用法: $0 [dashboard|wizard|check|fleet-scan|logs|service|hermes|install|version|help]"; exit 1 ;;
  esac
fi

# ═══ Main ═══
show_menu
