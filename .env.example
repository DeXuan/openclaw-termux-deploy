# OpenClaw Termux Deploy — Fleet Configuration
# Copy this file and fill in your values

# ── Model Provider ──
# Choices: deepseek, qwen-portal, alibaba-model-studio, custom
PROVIDER=deepseek
API_KEY=sk-your-key-here
MODEL=deepseek/deepseek-v4-flash

# ── Gateway ──
GATEWAY_PORT=18789
GATEWAY_BIND=loopback
GATEWAY_TOKEN=auto-generate-or-paste

# ── Feishu Alerts ──
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_RECEIVE_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Fleet SSH ──
K60_IP=192.168.1.23
MIX2S_IP=192.168.1.20
NOTE7_IP=100.91.94.44
NOTE4X_IP=192.168.1.19
SSH_PORT=8022

# ── QQ Bot ──
QQ_APP_ID=102825839
QQ_APP_SECRET=xxxxxxxxxxxxxxxx

# ── Optional: WeChat iLink ──
WECHAT_BOT_ID=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxx

# ── Optional: Monitoring ──
DASHBOARD_TIME=08:57
FUND_REPORT_TIME=15:30
BACKUP_DAY=Sun
BACKUP_TIME=02:00
