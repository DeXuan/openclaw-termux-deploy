#!/data/data/com.termux/files/usr/bin/sh
# OpenClaw runit run 脚本 — 手工参考模板
#
# ⚠️ 本文件仅作理解 runit 服务结构的手工参考。
# 实际部署会由 phone_setup_service.sh 动态生成 run 脚本（含坑25 shebang 修复 +
# 低内存机型 --max-old-space-size 自适应）。
# 生产环境请勿直接使用本模板，应走: cat phone_setup_service.sh | ssh ... 'sh -'
#
# 生成逻辑对应关系:
#   install.sh [5/6]        → 内联生成 run 脚本（curl-pipe 自包含）
#   phone_setup_service.sh  → SSH 管道生成（canonical，含坑25修复）
exec 2>&1
# 坑14：QQ 等平台 IP 白名单只支持 IPv4
export NODE_OPTIONS="--dns-result-order=ipv4first"

# 坑25：必须显式调 node + .mjs 绝对路径
# npm root -g → /data/data/com.termux/files/usr/lib/node_modules/openclaw/openclaw.mjs
exec /data/data/com.termux/files/usr/bin/node /data/data/com.termux/files/usr/lib/node_modules/openclaw/openclaw.mjs gateway
